{
  "name": "scalecraft",
  "version": "6.1.1-alpha",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=\"$NODE_OPTIONS --no-network-family-autoselection\" next dev",
    "build": "next build",
    "start": "NODE_OPTIONS=\"$NODE_OPTIONS --no-network-family-autoselection\" next start",
    "analyze": "next experimental-analyze -o",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test vitest run",
    "test:flows": "NODE_ENV=test vitest run src/flows",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS=\"$NODE_OPTIONS --no-network-family-autoselection\" dotenv -e .env.local -- node scripts/migrate.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@clerk/nextjs": "^7.5.17",
    "@hookform/resolvers": "^5.4.0",
    "@mdx-js/mdx": "^3.1.1",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-popover": "^1.1.19",
    "@tanstack/react-query": "^5.101.2",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "drizzle-orm": "^0.45.2",
    "github-slugger": "^2.0.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.24.0",
    "mermaid": "^11.16.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@clerk/backend": "^3.16.4",
    "@clerk/testing": "^2.2.22",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "unified": "^11.0.5",
    "vitest": "^4.1.10"
  }
}
