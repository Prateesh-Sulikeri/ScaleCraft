# Copy to .env.local and fill in once these services are provisioned.
# See .claude/docs/OPEN_QUESTIONS.md — neither is required to run `npm run dev`
# for the canvas/validation-engine scaffold; both are needed before
# persistence/auth go live.

# Neon Postgres connection string (src/db/client.ts)
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Playwright e2e (npm run test:e2e) - dedicated Clerk test-instance user,
# +clerk_test email so no real emails are sent. Created/updated automatically
# by e2e/global.setup.ts on each run.
E2E_CLERK_USER_EMAIL=
E2E_CLERK_USER_PASSWORD=

# Brevo (src/app/api/feedback/route.ts) - Home's footer feedback survey, sent
# through Brevo's transactional API. These are server-only on purpose: unlike
# the EmailJS public key this replaced, the Brevo key is a secret and must never
# be NEXT_PUBLIC_*. With BREVO_API_KEY or BREVO_SENDER_EMAIL missing the survey
# still works - it falls back to opening the visitor's mail client with the
# answers pre-filled (no attachments on that path), so the feature is usable
# before these are set.
#
# BREVO_API_KEY        Brevo dashboard -> SMTP & API -> API Keys (xkeysib-...).
# BREVO_SENDER_EMAIL   Must be a *verified* sender in Brevo (Senders, Domains &
#                      Dedicated IPs -> Senders); Brevo rejects the send
#                      outright otherwise.
# BREVO_SENDER_NAME    Display name on the From line. Optional.
# FEEDBACK_RECIPIENT_EMAIL  Where submissions land. Optional - defaults to
#                      FEEDBACK_RECIPIENT in src/home/feedback.ts.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ScaleCraft Feedback
FEEDBACK_RECIPIENT_EMAIL=

# Bug report retention (src/bugs/author-auth.ts). Vercel Cron sends this as
# `Authorization: Bearer $CRON_SECRET` on every invocation of the nightly
# /api/cron/bug-retention sweep, and the same value authenticates the
# author-side POST /api/bugs/[id]/close (and scripts/close-bug.mjs).
#
# Both routes fail closed with a 503 when this is unset - they delete rows, so
# an unconfigured deployment must not leave them open. Any long random string:
# `openssl rand -hex 32`.
CRON_SECRET=

# Where scripts/close-bug.mjs sends its request. Defaults to
# http://localhost:3000; set it to the production URL to close a bug for real.
SCALECRAFT_BASE_URL=
